					<string>WFTextTokenAttachment</string>
				</dict>
			</dict>
		</dict>

		<!-- 4: 組合 NutriMate URL（含魔法變數） -->
		<!-- URL template (actual string, & not escaped here):
		     https://willy0929716513-debug.github.io/JBO/?wk=1&type=<0xFFFC>&dur=<0xFFFC>&kcal=<0xFFFC>&dist=<0xFFFC>&date=<0xFFFC>
		     Positions (0-indexed): type={55,1} dur={61,1} kcal={68,1} dist={75,1} date={82,1} -->
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.gettext</string>
