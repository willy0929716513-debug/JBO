										<string>WFPropertyAggrandizement</string>
										<key>PropertyName</key>
										<string>Activity Type</string>
										<key>PropertyUserInfo</key>
										<integer>0</integer>
									</dict>
								</array>
							</dict>
							<key>{61, 1}</key>
							<dict>
								<key>Type</key>
								<string>ActionOutput</string>
								<key>OutputName</key>
								<string>最新運動</string>
								<key>OutputUUID</key>
								<string>A1000002-0002-0002-0002-000000000002</string>
								<key>Aggrandizements</key>
								<array>
									<dict>
										<key>Type</key>
										<string>WFPropertyAggrandizement</string>
										<key>PropertyName</key>
										<string>Duration</string>
										<key>PropertyUserInfo</key>
										<integer>0</integer>
									</dict>
								</array>
							</dict>
							<key>{68, 1}</key>
							<dict>
								<key>Type</key>
								<string>ActionOutput</string>
								<key>OutputName</key>
								<string>最新運動</string>
								<key>OutputUUID</key>
								<string>A1000002-0002-0002-0002-000000000002</string>
								<key>Aggrandizements</key>
								<array>
									<dict>
										<key>Type</key>
