				<key>CustomOutputName</key>
				<string>健身運動</string>
				<key>WFHealthType</key>
				<string>Workout</string>
				<key>WFHealthLimitResults</key>
				<true/>
				<key>WFHealthMaximumResults</key>
				<integer>1</integer>
				<key>WFHealthSortDirection</key>
				<string>Latest First</string>
			</dict>
		</dict>

		<!-- 2: 取得第一筆 -->
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.getitemfromlist</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
